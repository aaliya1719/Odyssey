# Supabase Configuration
# Create a project at https://supabase.com and copy its project URL here.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable/anon key only. Never put a service-role key in Vite variables.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required only when deploying the suggest-mission Edge Function.
# GEMINI_API_KEY=your-gemini-api-key